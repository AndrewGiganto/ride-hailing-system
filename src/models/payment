class Payment:
    def __init__(self, payment_id: str, amount: float, method: str):
        self.payment_id = payment_id
        self.amount = amount
        self.method = method  # Cash, GCash, Credit Card
        self.status = "PENDING"

    def process_payment(self):
        # Simulating payment execution
        self.status = "SUCCESS"
        print(f"Successfully processed payment of ₱{self.amount:.2f} via {self.method}.")

