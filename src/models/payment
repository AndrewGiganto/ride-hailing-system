class Payment:
    def __init__(self, paymentid: str, amount: float):
        self.paymentid = paymentid
        self.amount = amount
        self.isPaid = False

    def process_payment(self) -> bool:
        self.isPaid = True
        print(f"Payment {self.paymentid} amounting to ₱{self.amount:.2f} successfully processed.")
        return self.isPaid

    def get_amount(self) -> float:
        return self.amount
